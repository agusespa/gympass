{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DB_PATH=data/dev.db PORT=8080 ./bin/gym-tracker"
      ],
      "port": 8080
    }
  ]
}